# Kostenloser Alpaca-Account genuegt: https://alpaca.markets/
# API-Key + Secret stehen direkt im Dashboard nach der Anmeldung.
# Fuer Backtesting und Paper-Trading braucht es nur diese Keys (kein Kapital involviert).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional: Discord-Webhook-URL fuer ENTRY/EXIT-Benachrichtigungen im Paper-Trading.
# Server > Kanaleinstellungen > Integrationen > Webhooks > Neuer Webhook > URL kopieren.
# Leer lassen = keine Benachrichtigungen, Bot laeuft trotzdem normal.
DISCORD_WEBHOOK_URL=
